# Scratch space for local experiments / one-off verification scripts.
# Kept inside the work tree (never /tmp) so nothing escapes the repo boundary,
# and ignored here + in python/.gitignore + python/.dockerignore.
.scratch/
**/.scratch/

# Python (ML training: /python)
python/.venv/
python/__pycache__/
python/**/__pycache__/
python/*.egg-info/
python/.ruff_cache/
python/.pytest_cache/
python/model/models/*.pkl
python/model/models/*.joblib
python/model/models/*.skops
*.pyc

# Claude Code agent worktrees (nested biome.json breaks `pnpm lint`)
.claude/worktrees/
