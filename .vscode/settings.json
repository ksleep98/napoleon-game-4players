{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "biomejs.biome",
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },

  // Prettier for YAML and Markdown (Biome doesn't support these)
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "problems.decorations.enabled": false
  },
  "[yml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // Enhanced Biome settings
  "biome.lsp.bin": "./node_modules/@biomejs/biome/bin/biome",

  // File associations for better support
  "files.associations": {
    "*.json": "json",
    "*.jsonc": "jsonc",
    "biome.json": "jsonc"
  },

  // GitHub Actions YAML settings
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml"
  },
  "yaml.customTags": [
    "!And",
    "!If",
    "!Not",
    "!Equals",
    "!Or",
    "!FindInMap sequence",
    "!Base64",
    "!Cidr",
    "!Ref",
    "!Sub",
    "!GetAtt",
    "!GetAZs",
    "!ImportValue",
    "!Select",
    "!Split",
    "!Join sequence"
  ],

  // GitHub Actions extension settings
  "github-actions.workflows.pinned.workflows": [".github/workflows"],
  "github-actions.workflows.pinned.refresh.enabled": true,

  // Disable problematic diagnostics for GitHub Actions
  "problems.decorations.enabled": true,
  "yaml.schemaStore.enable": true,
  "yaml.schemaStore.url": "https://www.schemastore.org/api/json/catalog.json",

  // Language server settings for YAML
  "yaml.trace.server": "off",
  "yaml.validate": true,
  "yaml.completion": true,
  "yaml.hover": true,
  "yaml.format.enable": true,
  "yaml.maxItemsComputed": 5000,

  // Specific settings for GitHub Actions files
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    }
  },

  // Disable telemetry and unnecessary warnings
  "redhat.telemetry.enabled": false,
  "extensions.ignoreRecommendations": false,

  // Advanced YAML diagnostics settings
  "yaml.disableDefaultProperties": false,
  "yaml.suggest.parentSkeletonSelectedFirst": true,
  "yaml.keyOrdering": false,

  // TypeScript/JavaScript convenience features
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",

  // Performance optimizations
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/out/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.pnpm-store/**": true,
    "**/coverage/**": true,
    "**/playwright-report/**": true,
    "**/test-results/**": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": false,
    "**/.next": true,
    "**/out": true,
    "**/coverage": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/out": true,
    "**/dist": true,
    "**/build": true,
    "**/coverage": true,
    "**/.pnpm-store": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "**/pnpm-lock.yaml": true
  },

  // TypeScript performance
  "typescript.tsserver.maxTsServerMemory": 4096,
  "typescript.disableAutomaticTypeAcquisition": false,
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,

  // Editor performance
  "editor.semanticHighlighting.enabled": true,
  "editor.suggest.showWords": false,
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  }
}
