{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Napoleon Game (4 Players) - Team shared Claude Code settings",
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(docker:*)",
      "Bash(./scripts/*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(less:*)",
      "Bash(more:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(wc:*)",
      "Bash(tree:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(fd:*)",
      "Bash(diff:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(cut:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(tr:*)",
      "Bash(terraform init:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform show:*)",
      "Bash(terraform output:*)",
      "Bash(terraform providers:*)",
      "Bash(terraform fmt -check:*)",
      "Bash(vercel env pull:*)",
      "Bash(ruff check:*)",
      "WebSearch",
      "mcp__serena__*",
      "mcp__github__*",
      "Bash(cd:*)",
      "Bash(ln:*)",
      "Bash(pnpm -C:*)",
      "Bash(npx jest:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(curl -s -o /dev/null:*)"
    ],
    "deny": ["Bash(rm -rf /)", "Bash(sudo rm:*)", "Bash(git push --force:*)"],
    "ask": [
      "Bash(rm -rf:*)",
      "Bash(find * -delete*)",
      "Bash(pnpm add:*)",
      "Bash(uv add:*)",
      "Bash(brew install:*)",
      "Bash(pnpm publish:*)",
      "Bash(vercel --prod:*)"
    ]
  },
  "rules": {
    "coding": {
      "language": "TypeScript",
      "style": "Biome",
      "conventions": "Conventional Commits",
      "importStyle": "static"
    },
    "branch": {
      "protected": ["main", "develop"],
      "pattern": "feature/*"
    },
    "testing": {
      "required": true,
      "framework": "Jest",
      "coverage": "recommended"
    }
  },
  "enableAllProjectMcpServers": true
}
