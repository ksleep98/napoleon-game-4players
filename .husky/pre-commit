
echo "🚀 Pre-commit checks starting..."

# Check if committing to develop branch (must be first check)
current_branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$current_branch" = "develop" ]; then
    echo ""
    echo "❌ Error: Direct commits to develop branch are not allowed"
    echo ""
    echo "🔧 To fix this:"
    echo "  1. Create a feature branch: git checkout -b feature/your-feature-name"
    echo "  2. Or switch to existing branch: git checkout your-branch-name"
    echo ""
    echo "📝 Current staged changes will be preserved when you switch branches"
    echo ""
    exit 1
fi

# Run lint-staged for automatic fixes
echo "📝 Running automatic fixes on staged files..."
npx lint-staged

# Workflow を変えたら actions.lock と食い違っていないか確認する。
# 食い違うと GitHub がその workflow を parse エラーで起動しなくなり、PR では
# チェック自体が出ないので気づけない（#666 で python.yml / security-audit.yml が停止）
if git diff --cached --name-only | grep -qE '^\.github/workflows/.+\.ya?ml$'; then
  if gh actions-lock --help >/dev/null 2>&1; then
    echo "🔒 Verifying .github/workflows/actions.lock..."
    if ! gh actions-lock --no-fix; then
      echo "❌ actions.lock is out of date. Run 'gh actions-lock' and stage the lockfile."
      exit 1
    fi
  else
    echo "⚠️  gh actions-lock is not installed; skipping lockfile check (gh extension install github/gh-actions-lock)"
  fi
fi

# Additional comprehensive checks
echo "🔍 Running comprehensive quality checks..."

# Run type check on entire project
echo "🔧 TypeScript type checking..."
if ! pnpm type-check; then
  echo "❌ Type check failed. Please fix TypeScript errors before committing."
  exit 1
fi

# Run all tests with consistent environment variables (same as CI)
echo "🧪 Running tests..."
if ! pnpm test:ci; then
  echo "❌ Tests failed. Please fix failing tests before committing."
  exit 1
fi

echo "✅ All pre-commit checks passed!"
echo "🎉 Ready to commit!"
