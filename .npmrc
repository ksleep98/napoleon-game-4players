# ========================================
# サプライチェーン攻撃対策設定
# ========================================

# 1. クールダウン機能（7日間）
# パッケージ公開から7日経過するまでインストールを遅延
# 悪意のあるパッケージの80%が1週間以内に検出・削除されるため
# 参考: https://zenn.dev/dely_jp/articles/supply-chain-kowai
minimumReleaseAge=10080

# 2. インストールスクリプト無効化
# postinstall/preinstall スクリプトの自動実行を防止
# pnpm v10 では allowBuilds で許可管理可能
ignore-scripts=true

# 3. パッケージ検証強化
# パッケージの整合性チェックを厳密に実行
package-lock=true

# ========================================
# 通常の設定
# ========================================

# pnpm store location
# store-dir=~/.pnpm-store

# shamefully-hoist (Next.js互換性のため必要な場合のみ)
# shamefully-hoist=false

# strict-peer-dependencies (デフォルト: true)
# strict-peer-dependencies=true

# ========================================
# 緊急時の対応
# ========================================
#
# 緊急でパッケージ更新が必要な場合:
# 1. package.json に overrides を追加:
#    "pnpm": {
#      "overrides": {
#        "vulnerable-package": "safe-version"
#      }
#    }
#
# 2. 一時的にクールダウンを無効化:
#    minimumReleaseAge=0
#
# 3. 修正後は必ず元に戻すこと
# ========================================
